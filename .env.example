# Copy to .env and fill in real values for full functionality.
# With DEMO_MODE=true (and no DATABASE_URL), the app serves
# read-only demo listings so the home and listing UI can run locally.

DEMO_MODE=true

# App URL (used by Better Auth and client API calls)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL (required when DEMO_MODE=false)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Google OAuth (optional; leave blank to disable social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudinary (required for creating listings / image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional Google Maps JavaScript API (embed works without this)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
